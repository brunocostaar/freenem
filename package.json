{
  "name": "freenem",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @freenem/api dev\" \"pnpm --filter @freenem/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @freenem/api db:generate",
    "db:migrate": "pnpm --filter @freenem/api db:migrate",
    "db:seed": "pnpm --filter @freenem/api db:seed",
    "ingest:enem": "pnpm --filter @freenem/ingest run import:enem",
    "ingest:ppl": "pnpm --filter @freenem/ingest run import:enem-ppl",
    "ingest:tri": "pnpm --filter @freenem/ingest run import:tri",
    "ingest:vestibulares": "pnpm --filter @freenem/ingest run import:vestibulares",
    "ingest:review": "pnpm --filter @freenem/ingest run review:auto",
    "e2e": "pnpm --filter @freenem/e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
