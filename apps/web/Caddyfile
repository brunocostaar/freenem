{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# API_UPSTREAM: ex. http://api.railway.internal:3340 (rede privada do Railway)
	@backend path /api/* /files/* /health
	handle @backend {
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
