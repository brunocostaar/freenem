{
  "name": "@freenem/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "import:enem": "tsx --env-file-if-exists=../../apps/api/.env src/cli.ts enem",
    "import:tri": "tsx --env-file-if-exists=../../apps/api/.env src/cli.ts tri",
    "import:fuvest": "tsx --env-file-if-exists=../../apps/api/.env src/cli.ts fuvest",
    "import:ufrgs": "tsx --env-file-if-exists=../../apps/api/.env src/cli.ts ufrgs",
    "classify:llm": "tsx --env-file-if-exists=../../apps/api/.env src/cli.ts classify-llm",
    "classify:report": "tsx --env-file-if-exists=../../apps/api/.env src/cli.ts report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@freenem/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
